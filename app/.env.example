# app.config.ts が読む環境変数のサンプル。
# ローカル開発では `cp .env.example .env` してから値を書き換える
# (Expo CLI は .env を自動で読み込む: https://docs.expo.dev/guides/environment-variables/)。
# EAS Build では eas.json の env ブロック、または EAS の Environment Variables
# (https://docs.expo.dev/eas/environment-variables/) で渡すこと。

# --- アプリの見た目 ---
APP_NAME=WebApp
APP_SLUG=pushshell
# ディープリンク / カスタム URL スキーム (英小文字のみ)
APP_SCHEME=pushshell
APP_VERSION=1.0.0

# --- アイコン / スプラッシュ (assets/ のプレースホルダー PNG を差し替える場合はパスを変更) ---
APP_ICON=./assets/icon.png
APP_ADAPTIVE_ICON_FOREGROUND=./assets/android-icon-foreground.png
# Android adaptive icon の背景色
APP_ADAPTIVE_ICON_BACKGROUND=#FFFFFF
APP_ADAPTIVE_ICON_MONOCHROME=./assets/android-icon-monochrome.png
APP_SPLASH_IMAGE=./assets/splash-icon.png
APP_SPLASH_BACKGROUND=#FFFFFF

# expo-notifications プラグインの通知アイコン/色 (任意。Android のみ)
# APP_NOTIFICATION_ICON=./assets/notification-icon.png
# APP_NOTIFICATION_COLOR=#FFFFFF

# --- バンドル ID ---
IOS_BUNDLE_ID=com.example.pushshell
ANDROID_PACKAGE=com.example.pushshell

# --- 表示する Web アプリ / バックエンド ---
WEBAPP_URL=https://example.com
API_BASE_URL=http://localhost:8080

# WebView が読み込みを許可する origin と、bridge.ts がメッセージ送信元として信頼する
# origin (カンマ区切り)。未設定なら WEBAPP_URL の origin から自動導出される。
# ALLOWED_ORIGINS=https://example.com

# Universal Links (iOS) / App Links (Android) でアプリを開くホスト (カンマ区切り、
# スキーム・パス・ポートなしのホスト名のみ)。未設定なら無効 (従来どおりの挙動)。
# 指定したホストは https://<host> として ALLOWED_ORIGINS にも自動で追加される。
# 各ホストの /.well-known/ に apple-app-site-association と assetlinks.json を置くこと
# (テンプレートは examples/well-known/ を参照)。
# ASSOCIATED_DOMAINS=example.com,www.example.com

# --- Expo Push Token の取得に必要 (`eas init` 後に app.json / eas.json から確認できる) ---
EAS_PROJECT_ID=

# 通知の配送方式 (バックエンドの PUSH_PROVIDER と揃える)
#   expo:   Expo Push Token を登録 (EAS_PROJECT_ID が必要。Expo Push Service 経由で配送)
#   native: FCM / APNs のネイティブトークンだけを登録 (Expo のプロジェクト不要。バックエンドが FCM/APNs を直接叩く)
PUSH_PROVIDER=expo

# --- Android で FCM (google-services.json) を使う場合のパス ---
# GOOGLE_SERVICES_JSON=./google-services.json

# --- Android WebView の描画レイヤー (none / software / hardware) ---
# GPU の無いエミュレータや一部端末で WebView がクラッシュする場合に software を指定する
# WEBVIEW_ANDROID_LAYER_TYPE=none

# --- http:// を許可する (ローカル開発 / エミュレータ検証用。本番は false) ---
# ANDROID_USES_CLEARTEXT_TRAFFIC=false

# --- release ビルドの署名 (未設定なら debug keystore で署名される) ---
# ANDROID_KEYSTORE_PATH=./release.keystore
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
