# backend/.env.example
#
# このファイルをコピーして .env (mise の [env] _.file で自動読込) や
# シェルの環境変数として使う。すべて internal/config.Load() が読む値。
#
#   cp .env.example .env.local
#
# .env / .env.local は .gitignore 済み。

# ---------------------------------------------------------------------------
# サーバー
# ---------------------------------------------------------------------------

# listen アドレス。
ADDR=:8080

# ログレベル: debug | info | warn | error
LOG_LEVEL=info

# graceful shutdown の待ち時間 (time.ParseDuration 形式)。
SHUTDOWN_TIMEOUT=10s

# ---------------------------------------------------------------------------
# DB (ent + Atlas。sqlite / mysql / postgres から選ぶ)
# ---------------------------------------------------------------------------

# DB_DIALECT: sqlite | mysql | postgres
DB_DIALECT=sqlite

# DB_DSN は database/sql に渡す DSN。DB_DIALECT ごとに書式が異なる。
#
#   sqlite (modernc.org/sqlite, CGO なし):
#     file:data/app.db?_pragma=foreign_keys(1)&_pragma=journal_mode(WAL)
#
#   mysql (go-sql-driver/mysql):
#     user:pass@tcp(127.0.0.1:3306)/notify?parseTime=true&charset=utf8mb4
#
#   postgres (jackc/pgx/v5 の database/sql ドライバ):
#     postgres://user:pass@127.0.0.1:5432/notify?sslmode=disable&search_path=public
#
DB_DSN=file:data/app.db?_pragma=foreign_keys(1)&_pragma=journal_mode(WAL)

# 起動時に ent の Schema.Create でスキーマを自動作成する (開発用)。
# 本番では false のままにし、Atlas の versioned migration
# (mise run db:apply) でスキーマを管理する。
DB_AUTO_MIGRATE=false

# ---------------------------------------------------------------------------
# 認証
# ---------------------------------------------------------------------------

# サーバー間 API (例: POST /v1/notifications) を守る X-API-Key の値。
# 空のままだと該当エンドポイントは常に 401 を返す。
API_KEY=

# ---------------------------------------------------------------------------
# Push 通知
# ---------------------------------------------------------------------------

# PUSH_PROVIDER: expo | native | log
#   expo:   Expo Push API (internal/push/expo.go) へ実際に送信する。
#           端末は pushToken (ExponentPushToken[...]) で登録されている必要がある。
#   native: FCM HTTP v1 (Android, internal/push/fcm.go) / APNs
#           (iOS, internal/push/apns.go) へ直接送信する。端末は deviceToken
#           (Android: FCM registration token、iOS: APNs device token の hex)
#           で登録されている必要がある。FCM_* / APNS_* のうち設定されている
#           方だけが有効になる (両方設定すれば両 OS に送れる。どちらも未設定
#           だと起動時エラー)。
#   log:    送信内容をログに出すだけ (internal/push/push.go の LogSender)。
#           ローカル開発・smoke test 向け。
PUSH_PROVIDER=expo

# Expo Push API のアクセストークン (任意。PUSH_PROVIDER=expo のとき使う)。
# https://docs.expo.dev/push-notifications/sending-notifications/#additional-security
EXPO_ACCESS_TOKEN=

# --- PUSH_PROVIDER=native: FCM (Android) ---
#
# Firebase コンソール → プロジェクトの設定 → サービスアカウント →
# 「新しい秘密鍵の生成」でダウンロードできる JSON を使う。
# FCM_SERVICE_ACCOUNT_FILE (ファイルパス) か FCM_SERVICE_ACCOUNT_JSON
# (JSON の中身をそのまま) のどちらか一方を設定する。
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=

# FCM_PROJECT_ID は省略可 (省略時はサービスアカウント JSON 内の
# "project_id" を使う)。
FCM_PROJECT_ID=

# --- PUSH_PROVIDER=native: APNs (iOS) ---
#
# Apple Developer → Certificates, Identifiers & Profiles → Keys で
# 「Apple Push Notifications service (APNs)」にチェックを入れて作成した鍵
# (.p8 ファイル、ダウンロードは一度だけ) を使う。
# APNS_KEY_FILE (.p8 のファイルパス) か APNS_KEY (.p8 の中身の PEM) の
# どちらか一方を設定する。
APNS_KEY_FILE=
APNS_KEY=

# APNS_KEY_ID は上記の鍵作成画面に表示される Key ID。
APNS_KEY_ID=
# APNS_TEAM_ID は Apple Developer の Membership に表示される Team ID。
APNS_TEAM_ID=
# APNS_TOPIC は apns-topic ヘッダに使う値 (通常はアプリのバンドル ID)。
APNS_TOPIC=
# APNS_ENVIRONMENT: sandbox | production (既定 production)。
# sandbox は Xcode からの開発ビルド (TestFlight/App Store 配布ではない)
# 向け。
APNS_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Atlas (migrations/ の適用・検証。backend/atlas.hcl の env { url = getenv("ATLAS_URL") })
# ---------------------------------------------------------------------------

# ATLAS_URL は `atlas migrate apply/status` (mise run db:apply / db:status) が
# 対象にする DB の URL。DB_DSN とは書式が異なるので注意 (Atlas は
# "<scheme>://..." 形式の URL を使う)。DB_DIALECT に応じて選ぶ。
#
#   sqlite:   sqlite://data/app.db
#   mysql:    mysql://user:pass@127.0.0.1:3306/notify
#   postgres: postgres://user:pass@127.0.0.1:5432/notify?sslmode=disable&search_path=public
#
ATLAS_URL=sqlite://data/app.db
